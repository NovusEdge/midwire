# Copy to .env. Never commit .env.

# Verdict thresholds. Annotate is the default; blocking is opt-in per tool.
MIDWIRE_MODE=annotate

# Probes run after a write. Past this timeout midwire fails open and counts it.
MIDWIRE_PROBE_TIMEOUT_MS=500

# Tools that fail closed instead, comma separated. Reserve for writes that move
# money or mutate durable state.
MIDWIRE_FAIL_CLOSED_TOOLS=

# Mock world used by the scenario runs.
MIDWIRE_MOCK_URL=http://127.0.0.1:8787
MIDWIRE_MOCK_DB=./mockworld.sqlite

# Fault injected into the mock service: none, drop_write, stale_read, duplicate.
MIDWIRE_MOCK_FAULT=none

# Claim extraction. Out of scope for the deterministic half; leave empty.
MIDWIRE_CLAIM_MODEL=
